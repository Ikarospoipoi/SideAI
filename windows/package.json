{
  "name": "sideai-windows",
  "version": "0.9.0",
  "private": true,
  "description": "SideAI Windows desktop companion",
  "author": "Ikarospoipoi",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && node scripts/copy-ui.cjs",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test test/*.test.cjs",
    "pack": "npm run build && electron-builder --win nsis zip --x64 --publish never",
    "smoke": "electron . --smoke-test",
    "game-lab": "electron . --game-lab"
  },
  "dependencies": {
    "jose": "6.2.15",
    "koffi": "3.3.7",
    "npm": "12.2.2"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "typescript": "5.9.3"
  },
  "build": {
    "appId": "io.github.ikarospoipoi.sideai",
    "productName": "SideAI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/koffi/**/*",
      "node_modules/@koromix/**/*",
      "node_modules/npm/**/*"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "SideAI-${version}-Windows-${arch}.${ext}",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true
    }
  }
}
